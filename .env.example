# Application
APP_NAME=The Lens of Truth API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173

# Services
DATABASE_URL=postgresql+psycopg://lens:lens@postgres:5432/lens
REDIS_URL=redis://redis:6379/0

# Frontend (Vite variables must be prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000

# Reserved for future adapters. Do not add real values to source control.
# NCBI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
