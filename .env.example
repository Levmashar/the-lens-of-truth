# Application
APP_NAME=The Lens of Truth API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/v1
CORS_ORIGINS=http://localhost:5173

# Services
DATABASE_URL=postgresql+psycopg://lens:lens@postgres:5432/lens
REDIS_URL=redis://redis:6379/0

# Phase 2 ingestion: raw, server-sanitized screenshots are held for at most 24 hours.
# Filesystem storage is for local/container development; add an approved object-storage adapter
# before deploying publicly.
UPLOAD_STORAGE_PATH=/app/runtime/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=25000000
UPLOAD_RETENTION_HOURS=24
RETENTION_CLEANUP_INTERVAL_SECONDS=300
OCR_EXECUTABLE=tesseract
OCR_TIMEOUT_SECONDS=20

# Phase 2 semantic claim extraction through miri-api. Set the URL in your local
# .env. If miri-api runs on the host, containers reach it via host.docker.internal.
# Either put the gateway token in the path (http://host:port/<token>/v1), or use
# a plain /v1 URL and set CLAIM_EXTRACTOR_API_KEY for Bearer authentication.
# The gateway's chatgpt-auto selects the ChatGPT Auto picker best-effort.
CLAIM_EXTRACTOR_PROVIDER=miri
# CLAIM_EXTRACTOR_BASE_URL=http://host.docker.internal:8001/<token>/v1
# CLAIM_EXTRACTOR_API_KEY=
CLAIM_EXTRACTOR_MODEL=chatgpt-auto
# Maximum time for one gateway attempt; at most one retry is made.
CLAIM_EXTRACTOR_TIMEOUT_SECONDS=55
# Hard deadline for the entire extraction, including a retry.
CLAIM_EXTRACTOR_TOTAL_TIMEOUT_SECONDS=115
CLAIM_EXTRACTOR_MAX_CLAIMS=20

# Phase 3B: import official NLM MeSH descriptor XML into this local index.
# No UMLS credential is needed. Until the index exists, entity IDs stay unresolved.
MESH_INDEX_PATH=/app/runtime/mesh/mesh.sqlite3

# Phase 4A: NCBI E-utilities. Supply a developer/organization contact email.
NCBI_TOOL=the_lens_of_truth
# NCBI_EMAIL=developer@example.org
# NCBI_API_KEY=
PUBMED_TIMEOUT_SECONDS=12
PUBMED_MAX_RETRIES=1
PUBMED_QUERY_RETMAX=10
PUBMED_CACHE_TTL_SECONDS=21600

# Frontend (Vite variables must be prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:8000

# Reserved for future adapters. Do not add real values to source control.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
